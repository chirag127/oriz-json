---
import '../styles/theme.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz-json — JSON power tool',
  description = 'Format, validate, query, diff, and convert JSON entirely in your browser. No upload, no signup, 100% client-side.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f7a4d" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="JSON" />
    <script is:inline>if("serviceWorker" in navigator){window.addEventListener("load",()=>navigator.serviceWorker.register("/sw.js",{scope:"/"}))}</script>
  </head>
  <body>
    <OzToolShell site="json" title="json" wordmarkHref="https://oriz.in" mainClass="wrap">
      <a slot="nav" href="https://github.com/chirag127/oriz-json">GitHub</a>
      <a slot="footer" href="https://github.com/chirag127/oriz-json">Source</a>
      <span slot="footer">100% client-side · no upload · MIT</span>
      <slot />
    </OzToolShell>
  </body>
</html>



